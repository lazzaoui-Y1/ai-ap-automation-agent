# ═══════════════════════════════════════════════════
# AI Invoice Processing - Environment Variables
# ═══════════════════════════════════════════════════

# ════════════════════════════════════════
# LLM Configuration (Groq)
# ════════════════════════════════════════
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Selection
# Options: llama-3.3-70b, llama-3.1-70b, llama-3.1-8b, mixtral-8x7b
LLM_MODEL=llama-3.3-70b

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=60

# ════════════════════════════════════════
# OCR Configuration
# ════════════════════════════════════════
# Tesseract path (optional - leave empty if in PATH)
# Linux: /usr/bin/tesseract
# macOS: /usr/local/bin/tesseract
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# OCR Language (ara, eng, fra, ara+eng+fra)
OCR_DEFAULT_LANG=ara+eng+fra

# OCR DPI for PDF conversion
OCR_DPI=200

# ════════════════════════════════════════
# Application Settings
# ════════════════════════════════════════
APP_NAME="AI Invoice Processing"
APP_VERSION=1.0.0
APP_ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ════════════════════════════════════════
# Logging
# ════════════════════════════════════════
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_JSON_FORMAT=true

# ════════════════════════════════════════
# Processing Settings
# ════════════════════════════════════════
# Confidence threshold (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7

# Maximum retries for failed extractions
MAX_RETRIES=3

# Processing timeout (seconds)
PROCESSING_TIMEOUT=120

# ════════════════════════════════════════
# Storage
# ════════════════════════════════════════
DATA_DIR=./customers
TEMP_DIR=./temp
BACKUP_DIR=./backups

# ════════════════════════════════════════
# Database (Optional - for future use)
# ════════════════════════════════════════
# DATABASE_URL=sqlite:///./invoices.db
# DATABASE_URL=postgresql://user:password@localhost/invoices

# ════════════════════════════════════════
# Email Configuration (Optional)
# ════════════════════════════════════════
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_FROM=noreply@yourcompany.com

# ════════════════════════════════════════
# Security (Optional)
# ════════════════════════════════════════
# API_KEY_REQUIRED=false
# SECRET_KEY=your_secret_key_here

# ════════════════════════════════════════
# Feature Flags
# ════════════════════════════════════════
ENABLE_VALIDATION=true
ENABLE_VENDOR_MAPPING=true
ENABLE_AUTO_BACKUP=false

# ════════════════════════════════════════
# Monitoring (Optional)
# ════════════════════════════════════════
# SENTRY_DSN=
# PROMETHEUS_ENABLED=false